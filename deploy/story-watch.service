[Unit]
Description=Instagram story watcher -> Discord
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=storywatch
Group=storywatch
# Shares data/ (state.db) and the archive with the bot, which runs as storywatch-bot (#45).
SupplementaryGroups=storywatch-shared
WorkingDirectory=/opt/story-watch
EnvironmentFile=/opt/story-watch/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/story-watch/.venv/bin/story-watch
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening (all of these work in an unprivileged LXC with nesting=1)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/story-watch/data /opt/story-watch/archive /opt/story-watch/.config/instaloader
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Group-writable files: the bot (group storywatch-shared) must write state.db and its WAL files, and
# read the archive. Nothing secret is group-shared: .config/instaloader and data/claude-home are
# 0700 directories, and what it creates elsewhere in its home gets its own group, storywatch.
UMask=0007

[Install]
WantedBy=multi-user.target
