# Burner Instagram account whose instaloader session file exists
IG_USER=
# Leave blank for instaloader's default: ~storywatch/.config/instaloader/session-<IG_USER>
IG_SESSION_PATH=
# Comma-separated usernames to watch. Add :userid (e.g. zero2sudo:50350974961)
# to skip the username lookup, which Instagram rate-limits (429) aggressively.
TARGETS=zero2sudo
# Discord: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK=
# Random wait between checks, seconds
MIN_WAIT=300
MAX_WAIT=600
# Alert after this many consecutive failures
FAIL_ALERT_THRESHOLD=3
# Local hour (0-23) for a daily "still alive" message; blank = off
HEARTBEAT_HOUR=
DB_PATH=/opt/story-watch/data/state.db
# Post types: job_posting, interview_info, misc. CLASSIFIER picks what assigns them
# (only "rules" today: any link = job_posting, else misc; interview_info needs the LLM).
CLASSIFIER=rules
# Per-type filters: false = record silently, never post
NOTIFY_JOB_POSTING=true
NOTIFY_INTERVIEW_INFO=true
NOTIFY_MISC=true
# Role pings: master switch, then comma-separated role IDs per type (Discord Developer
# Mode -> right-click role -> Copy Role ID). Blank = no ping for that type.
PING_ROLES=false
ROLE_JOB_POSTING=
ROLE_INTERVIEW_INFO=
ROLE_MISC=
# More Discord servers: DISCORD_WEBHOOK_<n> (n = 2, 3, ...) with ROLE_<TYPE>_<n> for
# that server's roles (PING_ROLES and NOTIFY_* apply to all). They get stories and
# deploy messages; alerts, heartbeat and --test-notify go only to DISCORD_WEBHOOK. Blank = off.
DISCORD_WEBHOOK_2=
ROLE_JOB_POSTING_2=
ROLE_INTERVIEW_INFO_2=
ROLE_MISC_2=
# scripts/resend_story.py only: test webhook and roles it pings (never used by the service)
TEST_DISCORD_WEBHOOK=
TEST_ROLE_JOB_POSTING=
TEST_ROLE_INTERVIEW_INFO=
TEST_ROLE_MISC=
