# Burner Instagram account whose instaloader session file exists
IG_USER=
# Leave blank for instaloader's default: ~storywatch/.config/instaloader/session-<IG_USER>
IG_SESSION_PATH=
# Comma-separated usernames to watch. Add :userid (e.g. zero2sudo:50350974961)
# to skip the username lookup, which Instagram rate-limits (429) aggressively.
TARGETS=zero2sudo
# Discord: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK=
# Random wait between checks, seconds
MIN_WAIT=300
MAX_WAIT=600
# Alert after this many consecutive failures
FAIL_ALERT_THRESHOLD=3
# Local hour (0-23) for a daily "still alive" message; blank = off
HEARTBEAT_HOUR=
DB_PATH=/opt/story-watch/data/state.db
# Save every new story (still image + a JSON sidecar; never video) here for evaluating taggers; blank = off.
# Absolute path. On the server use /opt/story-watch/archive (install.sh creates it, owned by
# storywatch). ARCHIVE_MAX_MB is the total cap; the oldest items are deleted past it.
ARCHIVE_DIR=
ARCHIVE_MAX_MB=2048
# Workstation only (scripts/pull_archive.py, not read by the service): where the pulled archive lands.
# ARCHIVE_PULL_DIR=~/story-watch-data/archive
# Labeling bot (story-watch-bot, a second service; skipped by install.sh while the token is blank).
# It posts each archived story in a private channel and saves what labelers choose. See HUMANS.md.
# Needs ARCHIVE_DIR above. One Discord server only. Never share or log the token.
DISCORD_BOT_TOKEN=
# The private channel stories are posted in (Developer Mode -> right-click -> Copy ID)
LABEL_CHANNEL_ID=
# Comma-separated Discord user ids allowed to label; everyone else is refused
LABELER_USER_IDS=
# Optional: where labels go (absolute path; default <ARCHIVE_DIR>/labels.jsonl), seconds between
# archive scans (default 30), how many of the newest stories to post on the very first start
# (default 10; older ones are skipped for good), and ignore stories older than this date.
LABELS_FILE=
LABEL_POLL_SECONDS=30
LABEL_BACKLOG_MAX=10
LABEL_SINCE=
# Post types: event, job_posting, process_info, misc (docs/tags.md). CLASSIFIER picks what
# assigns them (only "rules" today: any link = job_posting, else misc). NOTIFY_INTERVIEW_INFO is
# the old name of NOTIFY_PROCESS_INFO: it still works (with a deprecation warning) when the
# new one is unset.
CLASSIFIER=rules
# Per-type filters: false = record silently, never post
NOTIFY_EVENT=true
NOTIFY_JOB_POSTING=true
NOTIFY_PROCESS_INFO=true
NOTIFY_MISC=true
# Pings: there is no setting. Users choose what they are pinged for with /pings in the bot.
# PING_ROLES and ROLE_* were removed; delete them if they are still in your .env.
# scripts/resend_story.py only: test webhook, and the comma-separated user IDs it pings
# (Developer Mode -> right-click user -> Copy User ID). Never used by the service.
TEST_DISCORD_WEBHOOK=
TEST_PING_USER_IDS=
