# Burner Instagram account whose instaloader session file exists
IG_USER=
# Leave blank for instaloader's default: ~storywatch/.config/instaloader/session-<IG_USER>
IG_SESSION_PATH=
# Exact User-Agent of the browser the session cookies were taken from (navigator.userAgent).
# Blank = instaloader's default. Update it on every re-login and after browser updates.
IG_USER_AGENT=
# Comma-separated usernames to watch. Add :userid (e.g. zero2sudo:50350974961)
# to skip the username lookup, which Instagram rate-limits (429) aggressively.
TARGETS=zero2sudo
# Discord: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK=
# Random wait between checks, seconds
MIN_WAIT=1200
MAX_WAIT=2400
# Quiet hours: no Instagram requests in this daily window (HH:MM-HH:MM, may wrap midnight,
# e.g. 01:00-07:00); blank = off. QUIET_TZ is an IANA zone (America/Toronto); blank = system local time.
QUIET_HOURS=
QUIET_TZ=
# Alert after this many consecutive failures
FAIL_ALERT_THRESHOLD=3
# Local hour (0-23) for a daily "still alive" message; blank = off
HEARTBEAT_HOUR=
DB_PATH=/opt/story-watch/data/state.db
# Save every new story (still image + a JSON sidecar; never video) here for evaluating taggers; blank = off.
# Absolute path. On the server use /opt/story-watch/archive (install.sh creates it, owned by
# storywatch). ARCHIVE_MAX_MB is the total cap; the oldest items are deleted past it.
ARCHIVE_DIR=
ARCHIVE_MAX_MB=2048
# Workstation only (scripts/pull_archive.py, not read by the service): where the pulled archive lands.
# ARCHIVE_PULL_DIR=~/story-watch-data/archive
# Labeling bot (story-watch-bot, a second service; skipped by install.sh while the token is blank).
# It posts each archived story in a private channel and saves what labelers choose. See HUMANS.md.
# Needs ARCHIVE_DIR above. One Discord server only. Never share or log the token.
# On the server the bot runs as its own user and gets only its own keys (BOT_ENV_KEYS), which
# install.sh copies from this file into bot.env; it never sees the Claude token or IG settings.
# The bot also reads DISCORD_WEBHOOK (above, same file) to edit the watcher's own posts when someone
# uses "Fix tags"; without it a fix is still saved but the post keeps its old tags.
DISCORD_BOT_TOKEN=
# The private channel stories are posted in (Developer Mode -> right-click -> Copy ID)
LABEL_CHANNEL_ID=
# Comma-separated Discord user ids allowed to label; everyone else is refused
LABELER_USER_IDS=
# Optional: where labels go (absolute path; default <ARCHIVE_DIR>/labels.jsonl), seconds between
# archive scans (default 30), how many of the newest stories to post on the very first start
# (default 10; older ones are skipped for good), and ignore stories older than this date.
LABELS_FILE=
LABEL_POLL_SECONDS=30
LABEL_BACKLOG_MAX=10
LABEL_SINCE=
# Post types: event, job_posting, process_info, misc (docs/tags.md). CLASSIFIER picks what
# assigns them: "rules" (placeholder: any link = job_posting, else misc, the rest unsure),
# "claude" (Claude Opus via headless claude -p on your own plan; install.sh then installs a
# pinned Claude Code, see HUMANS.md) or "hybrid" (the local vision model plus rules; install.sh
# then installs and starts story-watch-llm). NOTIFY_INTERVIEW_INFO is the old name of NOTIFY_PROCESS_INFO:
# it still works (with a deprecation warning) when the new one is unset.
CLASSIFIER=rules
# CLASSIFIER=hybrid only. LLM_URL: the model server (must be local; default below). LLM_MODEL:
# the name sent with each request. LLM_TIMEOUT: seconds per story before the fallback tags
# (5-600, default 90). TAGGER_OCR: run RapidOCR on each still (default true).
LLM_URL=http://127.0.0.1:8090
LLM_MODEL=qwen3-vl-4b-instruct-q4_k_m
LLM_TIMEOUT=90
TAGGER_OCR=true
# CLASSIFIER=claude only. CLAUDE_CODE_OAUTH_TOKEN: from `claude setup-token` on your workstation
# (required with claude; a secret like the webhook: never share or log it). CLAUDE_MODEL: the model
# alias (default opus, what was scored). CLAUDE_TIMEOUT: seconds per story before the fallback tags
# (10-600, default 60). TAGGER_OCR above also applies: OCR reads the image for the fallback.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=opus
CLAUDE_TIMEOUT=60
# MARK_SEEN (#50): after a cycle with new stories, mark the ones handled (posted, filtered or dropped)
# seen on Instagram, as the web app does; the burner then shows in the target's viewer list. Default
# false. Confirm the request against a browser HAR capture before turning it on (see HUMANS.md).
MARK_SEEN=false
# Per-type filters: false = record silently, never post
NOTIFY_EVENT=true
NOTIFY_JOB_POSTING=true
NOTIFY_PROCESS_INFO=true
NOTIFY_MISC=true
# Pings: there is no setting. Users choose what they are pinged for with /pings in the bot.
# PING_ROLES and ROLE_* were removed; delete them if they are still in your .env.
# scripts/resend_story.py only: test webhook, and the comma-separated user IDs it pings
# (Developer Mode -> right-click user -> Copy User ID). Never used by the service.
TEST_DISCORD_WEBHOOK=
TEST_PING_USER_IDS=
